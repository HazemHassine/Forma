GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_COVER_LETTER_MODEL=gemini-3.7-flash
GEMINI_COMPANY_RESEARCH_MODEL=gemini-3.7-flash
OPENAI_API_KEY=
OPENAI_RESUME_MODEL=gpt-5.6-sol
OPENAI_COVER_LETTER_MODEL=gpt-5.6-sol
OPENAI_COMPANY_RESEARCH_MODEL=gpt-5.6-sol

# Optional. Defaults to ../local-data when running the backend directly.
# Docker Compose sets this to /app/data.
# CV_PERSONALIZER_DATA_DIR=../local-data

# Optional Supabase Postgres connection. Prefer the Session pooler URI on IPv4.
# Keep this server-side; never put it in a VITE_ variable or frontend file.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
